# Application Settings
PROJECT_NAME="ProofLens AI"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL 17 + pgvector)
# Adjust port (5432 or 5433 depending on local PostgreSQL installation)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/prooflens_db"
DATABASE_ECHO=false

# Storage Settings
STORAGE_DIR="storage/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Provider Settings
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
SIMILARITY_THRESHOLD_DEFAULT=0.65
TOP_K_DEFAULT=5
